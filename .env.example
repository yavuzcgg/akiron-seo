# Copy to .env and replace every value before deploying. docker-compose reads this file
# automatically. .env is gitignored; this example file is not.

# --- Database ---
POSTGRES_USER=akiron_user
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=akironseo_db

# --- Backend secrets ---
# Signs access tokens. Minimum 32 bytes. Rotating it invalidates every issued token.
# Generate: openssl rand -base64 48
JWT_SECRET_KEY=change-me-generate-a-random-256-bit-key

# Derives the AES-256-GCM key that encrypts every tenant's stored provider API key.
# Rotating it makes all previously stored BYOK keys undecryptable — they must be re-entered.
# Generate: openssl rand -base64 48
MASTER_ENCRYPTION_KEY=change-me-generate-a-random-key

# --- URLs ---
# Origin allowed by CORS; must match where the frontend is actually served from.
FRONTEND_ORIGIN=http://localhost:3000
AUTH_COOKIE_SECURE=false

# Baked into the frontend bundle at build time. Must be the browser-reachable API URL,
# not the internal Docker hostname.
NEXT_PUBLIC_API_URL=http://localhost:5248/api/v1
